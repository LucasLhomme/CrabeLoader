# CrabeLoader
# File description:
# Writes build_stamp.cpp and build_stamp.h: the build label, commit and time of this build.
# Runs at every build (cmake -P), and rewrites the files only when their text changes.
# A development build is labelled <version>-dev.<YYYYMMDD>.<HHMM>+<commit>; a release build <version>.
#
# Authors: @LucasLhomme
#
# Inputs: -DSOURCE_DIR=<repo> -DOUTPUT_DIR=<folder> -DVERSION=<x.y.z> -DRELEASE=<ON|OFF>

string(TIMESTAMP stamp_compact "%Y%m%d.%H%M")
string(TIMESTAMP stamp_readable "%Y-%m-%d %H:%M")

set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE head_result ERROR_QUIET)
    if(head_result EQUAL 0 AND head)
        set(commit "${head}")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE status_result ERROR_QUIET)
        if(status_result EQUAL 0 AND changes)
            set(commit "${commit}-dirty")
        endif()
    endif()
endif()

if(RELEASE)
    set(label "${VERSION}")
    set(is_release "true")
else()
    set(label "${VERSION}-dev.${stamp_compact}+${commit}")
    set(is_release "false")
endif()

set(cpp_text "// Generated by tools/build_stamp.cmake at every build; never edit.
#include \"shared/build_info.hpp\"

namespace crabe::build {

    std::string_view label() noexcept { return \"${label}\"; }
    std::string_view commit() noexcept { return \"${commit}\"; }
    std::string_view time() noexcept { return \"${stamp_readable}\"; }
    bool isRelease() noexcept { return ${is_release}; }

} // namespace crabe::build
")

set(h_text "/* Generated by tools/build_stamp.cmake at every build; never edit. */
#define CRABE_BUILD_LABEL \"${label}\"
#define CRABE_BUILD_LABEL_RC \"${label}\\0\"
")

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(kind cpp h)
    set(target "${OUTPUT_DIR}/build_stamp.${kind}")
    file(WRITE "${target}.tmp" "${${kind}_text}")
    file(COPY_FILE "${target}.tmp" "${target}" ONLY_IF_DIFFERENT)
    file(REMOVE "${target}.tmp")
endforeach()

/*
** CrabeLoader
** File description:
** The DLL version resource CMake stamps in from src/version.rc.in; never edit the output.
** This is what a file properties dialog shows for CrabeLoader.asi, so it must match the build.
** Declares no code; the same values reach C++ through include/shared/version.hpp.in.
**
** Authors: @LucasLhomme
*/

/*
** CrabeLoader Windows Resource Script (Generated automatically by CMake)
*/

#include <windows.h>
#include "build_stamp.h"

#define VER_FILEVERSION             1,1,0,0
#define VER_FILEVERSION_STR         "1.1.0.0\0"

#define VER_PRODUCTVERSION          1,1,0,0
#define VER_PRODUCTVERSION_STR      CRABE_BUILD_LABEL_RC

#define VER_COMPANYNAME_STR         "CrabeLoader Team\0"
#define VER_FILEDESCRIPTION_STR     "CrabeLoader Proxy DLL for Disney Infinity 3.0\0"
#define VER_INTERNALNAME_STR        "CrabeLoader\0"
#define VER_LEGALCOPYRIGHT_STR      "Copyright (C) 2026\0"
#define VER_ORIGINALFILENAME_STR    "CrabeLoader.asi\0"
#define VER_PRODUCTNAME_STR         "CrabeLoader\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      VER_COMPANYNAME_STR
            VALUE "FileDescription",  VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     VER_INTERNALNAME_STR
            VALUE "LegalCopyright",   VER_LEGALCOPYRIGHT_STR
            VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
            VALUE "ProductName",      VER_PRODUCTNAME_STR
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
